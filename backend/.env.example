# Server
PORT=4000
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
DB_NAME=learnflow
CORS_ORIGINS=http://localhost:3000

# Clerk: use keys from the same Clerk application
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
ADMIN_EMAILS=admin@example.com

# Demo login is for local development only
ENABLE_DEMO_LOGIN=false
JWT_SECRET=replace_with_a_long_random_secret

# Cloudinary: either CLOUDINARY_URL OR the three values below
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email notifications (Nodemailer SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
