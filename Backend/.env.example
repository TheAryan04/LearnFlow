# LearnFlow Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Optional: MongoDB Connection URI (If not set, LearnFlow automatically persists data in data/db.json)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/learnflow?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret

# Optional: Clerk Secret Key for backend JWT validation (https://dashboard.clerk.com)
# CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
